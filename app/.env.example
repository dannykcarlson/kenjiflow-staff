# Copy to .env (next to package.json). .env is git-ignored; never commit real keys.
# The Claude key can instead be saved in the app: Settings > Claude (stored encrypted).
ANTHROPIC_API_KEY=
# KF_MODEL=claude-opus-5-5
# KF_EFFORT=medium

# Where Google sends people back after connecting Gmail. Set this when the engine
# runs on a server with a domain, e.g. https://staff.northwindstudio.com
# KF_PUBLIC_URL=http://localhost:4310

# Connected apps (Gmail, HubSpot, QuickBooks…) through Composio. One Composio project per
# client, on KenjiFlow's Composio account (platform.composio.dev > project > API keys).
# A KenjiFlow Admin login can paste it in Settings > Connected apps instead.
# COMPOSIO_API_KEY=

# Long-term memory (Honcho, app.honcho.dev > API Keys). Unset = no long-term memory.
# One workspace per client; defaults to kf-<business name>.
# HONCHO_API_KEY=
# HONCHO_WORKSPACE_ID=kf-northwind-studio
# HONCHO_URL=http://localhost:8000   # only for a self-hosted Honcho

# Postgres on the client's server (unset = local PGlite in ./data)
# DATABASE_URL=postgres://user:pass@localhost:5432/kenjiflow
# KF_SECRET_KEY=   # optional: master key for encrypting stored secrets (else data/secret.key)
