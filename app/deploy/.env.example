# Copy to deploy/.env on the client's server and fill in. Never commit the real file.

# The address people use, e.g. staff.northwindstudio.com (point its DNS A record at this server first).
KF_DOMAIN=

# Owner login, created on first start. The server refuses to start without these.
KF_OWNER_EMAIL=
# At least 12 characters.
KF_OWNER_PASSWORD=
KF_OWNER_NAME=
KF_BUSINESS_NAME=

# Database password (any long random string).
POSTGRES_PASSWORD=

# Master key for stored secrets (Claude key, app tokens, notification keys). Any long random
# string. Keep a copy somewhere safe: without it, a database restore can't read its secrets.
KF_SECRET_KEY=

# The business's timezone, for recurring tasks (e.g. America/New_York).
TZ=

# Optional here: both can be set from the app instead (Settings).
ANTHROPIC_API_KEY=
COMPOSIO_API_KEY=

# Optional: long-term memory (Honcho).
# HONCHO_API_KEY=
